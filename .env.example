# Servidor
PORT=3001
DATA_BACKEND=auto

# auto: usa Firestore si hay credenciales; si no, guarda en server/.data/state.json
# firestore: exige credenciales de Firebase
# file: fuerza almacenamiento local en archivo

# Firebase Firestore (cuenta de servicio)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Alternativa: ruta a un service account JSON
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/al/service-account.json

# Firestore Emulator (opcional para desarrollo local)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# URL del API para el frontend (por defecto usa /api con proxy de Vite)
# VITE_API_URL=http://localhost:3001/api
