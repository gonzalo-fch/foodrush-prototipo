{
  "name": "foodrush-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --experimental-strip-types --watch server/index.js",
    "dev:all": "concurrently -k -n web,api -c blue,green \"npm:dev\" \"npm:dev:api\"",
    "server": "node --experimental-strip-types server/index.js",
    "start": "node --experimental-strip-types server/index.js",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.70.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.7",
    "jsdom": "^29.1.1",
    "oxlint": "^1.90.0",
    "supertest": "^7.3.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
